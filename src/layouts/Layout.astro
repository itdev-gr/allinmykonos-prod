---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'One Mykonos — Everything in Mykonos. One platform.',
  description = 'Book villas, restaurants, transfers, beach clubs, yachts and experiences in Mykonos. The all-in-one luxury concierge platform.',
} = Astro.props;

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const dashboardHref =
  profile?.role === 'admin' ? '/admin' : profile?.role === 'business' ? '/dashboard' : '/account';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-navy-900 text-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center justify-between h-16">
        <a href="/" class="flex items-baseline gap-1.5">
          <span class="font-display text-2xl font-semibold tracking-wide">One</span>
          <span class="font-display text-2xl font-light text-gold-400 tracking-wide">Mykonos</span>
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm text-navy-100">
          <a href="/search" class="hover:text-gold-300 transition-colors">Explore</a>
          <a href="/#categories" class="hover:text-gold-300 transition-colors">Categories</a>
          <a href="/partners" class="hover:text-gold-300 transition-colors">For Businesses</a>
        </nav>
        <div class="flex items-center gap-3 text-sm">
          {
            user ? (
              <>
                <a href={dashboardHref} class="hover:text-gold-300 transition-colors">
                  {profile?.full_name ?? 'My account'}
                </a>
                <form method="post" action="/api/auth/signout">
                  <button class="text-navy-200 hover:text-white transition-colors" type="submit">
                    Sign out
                  </button>
                </form>
              </>
            ) : (
              <>
                <a href="/login" class="hover:text-gold-300 transition-colors">
                  Log in
                </a>
                <a
                  href="/register"
                  class="rounded-full bg-gold-500 hover:bg-gold-400 text-navy-950 font-medium px-4 py-1.5 transition-colors"
                >
                  Sign up
                </a>
              </>
            )
          }
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy-950 text-navy-200 text-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>
          <span class="font-display text-white">One Mykonos</span> — Everything in Mykonos. One
          platform.
        </p>
        <div class="flex gap-6">
          <a href="/partners" class="hover:text-white transition-colors">Become a partner</a>
          <a href="/login" class="hover:text-white transition-colors">Log in</a>
        </div>
      </div>
    </footer>
  </body>
</html>
