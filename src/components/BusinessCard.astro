---
interface Props {
  business: {
    slug: string;
    name: string;
    description?: string | null;
    cover_url?: string | null;
    location_area?: string | null;
    verified?: boolean;
    categories?: { name: string } | null;
    reviews?: { rating: number }[];
  };
}

const { business: b } = Astro.props;
const ratings = b.reviews ?? [];
const avg = ratings.length ? ratings.reduce((s, r) => s + r.rating, 0) / ratings.length : null;
---

<a
  href={`/b/${b.slug}`}
  class="group rounded-2xl overflow-hidden bg-white border border-sand-200 hover:shadow-xl hover:border-gold-400 transition-all flex flex-col"
>
  <div class="aspect-[3/2] bg-navy-100 overflow-hidden relative">
    {
      b.cover_url ? (
        <img
          src={b.cover_url}
          alt={b.name}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-navy-200 font-display text-4xl">
          {b.name.charAt(0)}
        </div>
      )
    }
    {
      b.verified && (
        <span class="absolute top-3 right-3 rounded-full bg-navy-900/80 backdrop-blur text-gold-300 text-xs px-3 py-1">
          ✓ Verified
        </span>
      )
    }
  </div>
  <div class="p-5 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-2">
      <div class="font-display text-lg leading-snug">{b.name}</div>
      {
        avg && (
          <span class="text-sm text-navy-700 whitespace-nowrap">
            ★ {avg.toFixed(1)} <span class="text-navy-600/60">({ratings.length})</span>
          </span>
        )
      }
    </div>
    <div class="text-sm text-navy-600 mt-1">
      {b.categories?.name}{b.location_area ? ` · ${b.location_area}` : ''}
    </div>
    {
      b.description && (
        <p class="text-sm text-navy-600/80 mt-2 line-clamp-2 flex-1">{b.description}</p>
      )
    }
  </div>
</a>
