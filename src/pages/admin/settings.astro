---
import Layout from '../../layouts/Layout.astro';

const { data: setting } = await Astro.locals.supabase
  .from('platform_settings')
  .select('value')
  .eq('key', 'default_commission_pct')
  .maybeSingle();

const current = Number(setting?.value ?? 15);
const saved = Astro.url.searchParams.get('saved') === '1';
---

<Layout title="Settings — Admin">
  <div class="mx-auto max-w-xl px-4 sm:px-6 py-12">
    <a href="/admin" class="text-sm text-navy-600 hover:underline">← Admin</a>
    <h1 class="font-display text-3xl mt-2 mb-8">Platform settings</h1>

    {saved && (
      <div class="mb-6 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm px-4 py-3">
        ✓ Saved.
      </div>
    )}

    <form method="post" action="/api/admin/settings" class="bg-white rounded-2xl border border-sand-200 p-6 sm:p-8 space-y-4">
      <div>
        <label for="commission" class="block text-sm font-medium mb-1.5">
          Default commission (%)
        </label>
        <input
          id="commission"
          name="default_commission_pct"
          type="number"
          min="0"
          max="50"
          step="0.5"
          required
          value={current}
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400"
        />
        <p class="text-xs text-navy-600/70 mt-1.5">
          Applied to every booking unless a business has its own rate. Affects new bookings only.
        </p>
      </div>
      <button type="submit" class="w-full rounded-xl bg-navy-900 hover:bg-navy-700 text-white py-3 font-medium transition-colors">
        Save
      </button>
    </form>
  </div>
</Layout>
