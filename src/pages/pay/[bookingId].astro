---
import Layout from '../../layouts/Layout.astro';
import { formatPrice } from '../../lib/constants';

const { bookingId } = Astro.params;
const supabase = Astro.locals.supabase;

// RLS: customers can only load their own bookings.
const { data: booking } = await supabase
  .from('bookings')
  .select(
    `id, booking_ref, booking_date, start_time, guests, total_price, currency, status,
     services(title), businesses(name, slug), payments(id, status)`
  )
  .eq('id', bookingId!)
  .maybeSingle();

if (!booking) return Astro.redirect('/404');

const payment = (booking.payments as any[])?.[0];
if (!payment || payment.status === 'paid' || booking.status === 'cancelled') {
  return Astro.redirect(`/bookings/${booking.id}`);
}
---

<Layout title="Checkout — One Mykonos">
  <div class="mx-auto max-w-md px-4 py-12">
    <h1 class="font-display text-3xl mb-6 text-center">Checkout</h1>

    <div class="rounded-2xl bg-white border border-sand-200 p-6 mb-5">
      <div class="flex justify-between text-sm mb-1">
        <span class="text-navy-600">{(booking.services as any)?.title}</span>
      </div>
      <div class="text-sm text-navy-600 mb-4">
        {(booking.businesses as any)?.name} · {booking.booking_date} · {booking.guests}{' '}
        {booking.guests === 1 ? 'guest' : 'guests'}
      </div>
      <div class="border-t border-sand-200 pt-4 flex justify-between items-baseline">
        <span class="font-medium">Total</span>
        <span class="font-display text-2xl">{formatPrice(booking.total_price, booking.currency)}</span>
      </div>
    </div>

    <div class="mb-5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm px-4 py-3">
      🧪 <strong>Demo payment</strong> — no real charge is made. Online payments (Stripe) are
      activated at launch.
    </div>

    <form
      method="post"
      action="/api/payments/demo-complete"
      class="space-y-4 bg-white rounded-2xl border border-sand-200 p-6"
    >
      <input type="hidden" name="booking_id" value={booking.id} />
      <div>
        <label for="card" class="block text-sm font-medium mb-1.5">Card number</label>
        <input
          id="card"
          type="text"
          inputmode="numeric"
          value="4242 4242 4242 4242"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-gold-400"
        />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="exp" class="block text-sm font-medium mb-1.5">Expiry</label>
          <input id="exp" type="text" value="12/29"
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
        <div>
          <label for="cvc" class="block text-sm font-medium mb-1.5">CVC</label>
          <input id="cvc" type="text" value="123"
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
      </div>
      <button
        type="submit"
        class="w-full rounded-xl bg-navy-900 hover:bg-navy-700 text-white py-3 font-medium transition-colors"
      >
        Pay {formatPrice(booking.total_price, booking.currency)} (demo)
      </button>
    </form>
  </div>
</Layout>
