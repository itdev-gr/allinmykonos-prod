---
import Layout from '../layouts/Layout.astro';

const profile = Astro.locals.profile;

const { data: bookings } = await Astro.locals.supabase
  .from('bookings')
  .select('id, booking_ref, booking_date, start_time, guests, total_price, currency, status, services(title), businesses(name, slug)')
  .eq('user_id', Astro.locals.user!.id)
  .order('booking_date', { ascending: false });

const statusStyles: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-800',
  confirmed: 'bg-emerald-100 text-emerald-800',
  rejected: 'bg-red-100 text-red-700',
  cancelled: 'bg-gray-100 text-gray-600',
  completed: 'bg-navy-100 text-navy-700',
  no_show: 'bg-gray-100 text-gray-600',
};
---

<Layout title="My bookings — One Mykonos">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12">
    <h1 class="font-display text-3xl mb-1">My bookings</h1>
    <p class="text-navy-600 text-sm mb-8">Welcome{profile?.full_name ? `, ${profile.full_name}` : ''}.</p>

    {
      !bookings || bookings.length === 0 ? (
        <div class="rounded-2xl bg-white border border-sand-200 p-10 text-center">
          <p class="text-navy-600 mb-4">You have no bookings yet.</p>
          <a
            href="/"
            class="inline-block rounded-full bg-navy-900 hover:bg-navy-700 text-white px-6 py-2.5 text-sm font-medium transition-colors"
          >
            Explore Mykonos
          </a>
        </div>
      ) : (
        <ul class="space-y-4">
          {bookings.map((b: any) => (
            <li>
            <a href={`/bookings/${b.id}`} class="rounded-2xl bg-white border border-sand-200 hover:border-gold-400 hover:shadow-md transition-all p-5 flex items-center justify-between gap-4">
              <div>
                <div class="font-medium">{b.services?.title}</div>
                <div class="text-sm text-navy-600">
                  {b.businesses?.name} · {b.booking_date}
                  {b.start_time ? ` · ${String(b.start_time).slice(0, 5)}` : ''} · {b.guests}{' '}
                  {b.guests === 1 ? 'guest' : 'guests'}
                </div>
                <div class="text-xs text-navy-600/70 mt-1">Ref: {b.booking_ref}</div>
              </div>
              <div class="text-right">
                <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${statusStyles[b.status] ?? ''}`}>
                  {b.status}
                </span>
                <div class="font-medium mt-2">€{Number(b.total_price).toFixed(2)}</div>
              </div>
            </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>
