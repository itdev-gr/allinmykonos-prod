---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — One Mykonos">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-display text-7xl text-gold-500 mb-4">404</p>
    <h1 class="font-display text-2xl mb-3">This page drifted out to sea</h1>
    <p class="text-navy-600 mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="inline-block rounded-full bg-navy-900 hover:bg-navy-700 text-white px-8 py-3 font-medium transition-colors"
    >
      Back to One Mykonos
    </a>
  </div>
</Layout>
