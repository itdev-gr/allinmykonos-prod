---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/account');

const error = Astro.url.searchParams.get('error');
---

<Layout title="Sign up — One Mykonos">
  <div class="mx-auto max-w-md px-4 py-16 sm:py-24">
    <h1 class="font-display text-3xl text-center mb-2">Create your account</h1>
    <p class="text-center text-navy-600 text-sm mb-8">Book the best of Mykonos in minutes.</p>

    {
      error && (
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
          {error}
        </div>
      )
    }

    <form method="post" action="/api/auth/register" class="space-y-4 bg-white rounded-2xl border border-sand-200 p-6 sm:p-8 shadow-sm">
      <input type="hidden" name="role" value="customer" />
      <div>
        <label for="full_name" class="block text-sm font-medium mb-1.5">Full name</label>
        <input id="full_name" name="full_name" type="text" required
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium mb-1.5">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium mb-1.5">Phone <span class="text-navy-600/60">(optional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium mb-1.5">Password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>
      <button type="submit"
        class="w-full rounded-xl bg-navy-900 hover:bg-navy-700 text-white py-3 font-medium transition-colors">
        Sign up
      </button>
    </form>

    <p class="text-center text-sm text-navy-600 mt-6">
      Already have an account?
      <a href="/login" class="text-navy-900 font-medium underline underline-offset-2">Log in</a>
    </p>
  </div>
</Layout>
