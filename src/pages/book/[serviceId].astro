---
import Layout from '../../layouts/Layout.astro';
import { PRICING_LABEL, formatPrice } from '../../lib/constants';

const { serviceId } = Astro.params;
const supabase = Astro.locals.supabase;

const { data: service } = await supabase
  .from('services')
  .select('id, title, description, base_price, currency, pricing_type, businesses(name, slug, phone, email)')
  .eq('id', serviceId!)
  .maybeSingle();

if (!service) return Astro.redirect('/404');
const business = service.businesses as any;
---

<Layout title={`Book ${service.title} — One Mykonos`}>
  <div class="mx-auto max-w-xl px-4 sm:px-6 py-16 text-center">
    <a href={`/b/${business?.slug}`} class="text-sm text-navy-600 hover:underline">← Back to {business?.name}</a>
    <h1 class="font-display text-3xl mt-4 mb-2">{service.title}</h1>
    <p class="font-display text-2xl text-navy-700 mb-8">
      {formatPrice(service.base_price, service.currency)}
      <span class="text-sm text-navy-600 font-sans">{PRICING_LABEL[service.pricing_type]}</span>
    </p>
    <div class="rounded-2xl bg-white border border-sand-200 p-8">
      <p class="text-navy-600 mb-4">
        Online booking is launching very soon. In the meantime, reserve directly:
      </p>
      <div class="space-y-2 text-sm">
        {business?.phone && (
          <div>
            📞 <a href={`tel:${business.phone}`} class="font-medium hover:underline">{business.phone}</a>
          </div>
        )}
        {business?.email && (
          <div>
            ✉️ <a href={`mailto:${business.email}`} class="font-medium hover:underline">{business.email}</a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
