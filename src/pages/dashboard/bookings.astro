---
import Layout from '../../layouts/Layout.astro';
import { formatPrice } from '../../lib/constants';

const supabase = Astro.locals.supabase;

const { data: business } = await supabase
  .from('businesses')
  .select('id, name')
  .eq('owner_id', Astro.locals.user!.id)
  .maybeSingle();

if (!business) return Astro.redirect('/dashboard');

const { data: bookings } = await supabase
  .from('bookings')
  .select(
    `id, booking_ref, booking_date, guests, total_price, commission_amount, currency, status,
     special_requests, customer_name, customer_email, customer_phone, created_at,
     services(title), payments(status)`
  )
  .eq('business_id', business.id)
  .order('booking_date', { ascending: true });

const pending = (bookings ?? []).filter((b) => b.status === 'pending');
const upcoming = (bookings ?? []).filter((b) => b.status === 'confirmed');
const past = (bookings ?? []).filter((b) => !['pending', 'confirmed'].includes(b.status));

const statusCls: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-800',
  confirmed: 'bg-emerald-100 text-emerald-800',
  rejected: 'bg-red-100 text-red-700',
  cancelled: 'bg-gray-100 text-gray-600',
  completed: 'bg-navy-100 text-navy-700',
  no_show: 'bg-gray-100 text-gray-600',
};
---

<Layout title="Bookings — Dashboard">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12">
    <a href="/dashboard" class="text-sm text-navy-600 hover:underline">← Dashboard</a>
    <h1 class="font-display text-3xl mt-2 mb-8">Bookings — {business.name}</h1>

    {
      [
        ['Requests to confirm', pending, true],
        ['Upcoming', upcoming, true],
        ['History', past, false],
      ].map(([title, list, withActions]: any) => (
        <section class="mb-10">
          <h2 class="font-display text-xl mb-4">
            {title} <span class="text-navy-600/60 text-base">({list.length})</span>
          </h2>
          {list.length === 0 ? (
            <p class="text-sm text-navy-600">Nothing here.</p>
          ) : (
            <div class="space-y-3">
              {list.map((b: any) => (
                <div class="rounded-2xl bg-white border border-sand-200 p-5">
                  <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                      <div class="font-medium">{b.services?.title}</div>
                      <div class="text-sm text-navy-600 mt-0.5">
                        {b.booking_date} · {b.guests} {b.guests === 1 ? 'guest' : 'guests'} ·{' '}
                        <span class="font-mono text-xs">{b.booking_ref}</span>
                      </div>
                      <div class="text-sm text-navy-700 mt-2">
                        {b.customer_name} ·{' '}
                        <a href={`mailto:${b.customer_email}`} class="hover:underline">
                          {b.customer_email}
                        </a>
                        {b.customer_phone && <> · {b.customer_phone}</>}
                      </div>
                      {b.special_requests && (
                        <div class="text-sm text-navy-600 mt-1.5 italic">“{b.special_requests}”</div>
                      )}
                    </div>
                    <div class="text-right">
                      <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${statusCls[b.status]}`}>
                        {b.status}
                      </span>
                      <div class="font-medium mt-2">{formatPrice(b.total_price, b.currency)}</div>
                      <div class="text-xs text-navy-600/70">
                        fee {formatPrice(b.commission_amount, b.currency)}
                        {b.payments?.[0] && <> · {b.payments[0].status}</>}
                      </div>
                    </div>
                  </div>
                  {withActions && (
                    <div class="flex gap-2 mt-4 pt-4 border-t border-sand-100">
                      {b.status === 'pending' && (
                        <>
                          <form method="post" action="/api/dashboard/booking-status">
                            <input type="hidden" name="booking_id" value={b.id} />
                            <input type="hidden" name="action" value="confirm" />
                            <button class="rounded-full bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-1.5 text-sm font-medium transition-colors">
                              Accept
                            </button>
                          </form>
                          <form method="post" action="/api/dashboard/booking-status">
                            <input type="hidden" name="booking_id" value={b.id} />
                            <input type="hidden" name="action" value="reject" />
                            <button class="rounded-full border border-red-200 text-red-600 hover:bg-red-50 px-5 py-1.5 text-sm font-medium transition-colors">
                              Reject
                            </button>
                          </form>
                        </>
                      )}
                      {b.status === 'confirmed' && (
                        <>
                          <form method="post" action="/api/dashboard/booking-status">
                            <input type="hidden" name="booking_id" value={b.id} />
                            <input type="hidden" name="action" value="complete" />
                            <button class="rounded-full bg-navy-900 hover:bg-navy-700 text-white px-5 py-1.5 text-sm font-medium transition-colors">
                              Mark completed
                            </button>
                          </form>
                          <form method="post" action="/api/dashboard/booking-status">
                            <input type="hidden" name="booking_id" value={b.id} />
                            <input type="hidden" name="action" value="no_show" />
                            <button class="rounded-full border border-sand-200 hover:border-navy-200 px-5 py-1.5 text-sm font-medium transition-colors">
                              No show
                            </button>
                          </form>
                        </>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>
</Layout>
