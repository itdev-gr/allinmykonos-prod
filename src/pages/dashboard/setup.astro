---
import Layout from '../../layouts/Layout.astro';
import { MYKONOS_AREAS } from '../../lib/constants';

const supabase = Astro.locals.supabase;

// One business per account for now; send existing owners back to the dashboard.
const { data: existing } = await supabase
  .from('businesses')
  .select('id')
  .eq('owner_id', Astro.locals.user!.id)
  .maybeSingle();
if (existing) return Astro.redirect('/dashboard');

const { data: categories } = await supabase
  .from('categories')
  .select('id, name')
  .eq('active', true)
  .order('sort_order');

const error = Astro.url.searchParams.get('error');
---

<Layout title="Set up your business — One Mykonos">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 py-12">
    <h1 class="font-display text-3xl mb-2">Set up your business</h1>
    <p class="text-navy-600 text-sm mb-8">
      This creates your public profile. Our team reviews every business before it goes live.
    </p>

    {
      error && (
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
          {error}
        </div>
      )
    }

    <form
      method="post"
      action="/api/dashboard/business"
      class="space-y-5 bg-white rounded-2xl border border-sand-200 p-6 sm:p-8 shadow-sm"
    >
      <div>
        <label for="name" class="block text-sm font-medium mb-1.5">Business name *</label>
        <input id="name" name="name" type="text" required maxlength="80"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="category_id" class="block text-sm font-medium mb-1.5">Category *</label>
          <select id="category_id" name="category_id" required
            class="w-full rounded-xl border border-sand-200 bg-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400">
            <option value="">Choose…</option>
            {(categories ?? []).map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
        </div>
        <div>
          <label for="location_area" class="block text-sm font-medium mb-1.5">Area *</label>
          <select id="location_area" name="location_area" required
            class="w-full rounded-xl border border-sand-200 bg-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400">
            <option value="">Choose…</option>
            {MYKONOS_AREAS.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium mb-1.5">Description *</label>
        <textarea id="description" name="description" rows="4" required maxlength="2000"
          placeholder="What makes your business special?"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400"></textarea>
      </div>

      <div>
        <label for="address" class="block text-sm font-medium mb-1.5">Address</label>
        <input id="address" name="address" type="text" maxlength="200"
          class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="phone" class="block text-sm font-medium mb-1.5">Phone *</label>
          <input id="phone" name="phone" type="tel" required
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium mb-1.5">Public email</label>
          <input id="email" name="email" type="email"
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="website" class="block text-sm font-medium mb-1.5">Website</label>
          <input id="website" name="website" type="url" placeholder="https://…"
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
        <div>
          <label for="instagram" class="block text-sm font-medium mb-1.5">Instagram</label>
          <input id="instagram" name="instagram" type="text" placeholder="@yourbusiness"
            class="w-full rounded-xl border border-sand-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-gold-400" />
        </div>
      </div>

      <button type="submit"
        class="w-full rounded-xl bg-gold-500 hover:bg-gold-400 text-navy-950 py-3 font-medium transition-colors">
        Submit for review
      </button>
    </form>
  </div>
</Layout>
